# ==============================================================================
# ENVIRONMENT VARIABLES - RESTAURANT ORDERING PLATFORM
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Saves orders to table 'orders' with status 'Pending')
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: Service role key for backend operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Gmail SMTP Notification Configuration
# ------------------------------------------------------------------------------
# Sender Gmail address
GMAIL_USER=your-restaurant-or-personal@gmail.com

# 16-character Google App Password (NOT your normal Gmail login password)
# How to generate:
# 1. Go to https://myaccount.google.com/security
# 2. Ensure "2-Step Verification" is ON
# 3. Search "App Passwords" or go to https://myaccount.google.com/apppasswords
# 4. Create a new App Password named "Restaurant Order System"
# 5. Paste the 16-character string below (without spaces)
GMAIL_APP_PASSWORD=abcdxyzwwxyzabcd

# Where order summary emails should be delivered
NOTIFICATION_RECEIVER_EMAIL=rizariaz61@gmail.com

# ------------------------------------------------------------------------------
# 3. Admin Dashboard Authentication
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=admin123
